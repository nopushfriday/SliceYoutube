{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "slice-youtube",
  "version": "1.2.0",
  "identifier": "com.slice-youtube.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "slice-youtube",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage"],
    "windows": {
      "nsis": {
        "languages": ["Korean", "English"]
      }
    },
    "externalBin": ["binaries/yt-dlp", "binaries/ffmpeg", "binaries/deno"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
