{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "slice-youtube",
  "version": "1.3.3",
  "identifier": "com.slice-youtube.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "SliceYoutube",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "appimage"],
    "windows": {
      "nsis": {
        "template": "installer.nsi",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "uninstallerHeaderImage": "installer/uninstaller-header.bmp",
        "languages": ["Korean", "English"]
      }
    },
    "externalBin": ["binaries/yt-dlp", "binaries/ffmpeg", "binaries/deno"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMxMkZDNjg2Qzg0MTYwQTkKUldTcFlFSEloc1l2TVdkWGwzcE4xVDRiQVNYTHkwSjU3bWdOWU1jT241YjlIdW9OMjQ4cG9TRC8K",
      "endpoints": ["https://github.com/nopushfriday/slice-youtube/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
